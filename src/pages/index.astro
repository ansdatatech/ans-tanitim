  <section class="sec contact" id="iletisim">
    <svg class="circuit" data-seed="29" data-density="52000" aria-hidden="true"></svg>
    <div class="wrap">
      <div class="sec-head flush">
        <span class="eyebrow">İletişim &amp; Teklif</span>
        <h2>Projenizi birlikte hayata geçirelim</h2>
        <p class="lead">İhtiyaçlarınızı dinlemek ve size özel şeffaf bir teklif hazırlamak için iletişime geçin.</p>
      </div>
      <ul class="clist">
