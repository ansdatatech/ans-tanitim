  <footer>
    <div class="wrap"><span>© {year} ANS Yazılım & Veri Çözümleri. Tüm hakları saklıdır.</span><span>İşinizi Büyüten Teknoloji</span></div>
  </footer>
</BaseLayout>

<script>
  function drawCircuit(svg: SVGSVGElement) {
    const seedStart = Number(svg.dataset.seed ?? 11);
    const density = Number(svg.dataset.density ?? 40000);
    const box = svg.getBoundingClientRect();
    const W = Math.max(360, box.width);
    const H = Math.max(300, box.height);
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

    let s = seedStart;
    const r = () => {
      s = (s * 16807) % 2147483647;
      return s / 2147483647;
    };

    let out = '';
    let pulses = '';
    const n = Math.round((W * H) / density);
    for (let i = 0; i < n; i++) {
      const fromLeft = r() < 0.5;
      let y = Math.round((r() * H) / 20) * 20;
      let x = fromLeft ? -10 : W + 10;
      let d = `M${x} ${y}`;
      const steps = 2 + Math.floor(r() * 3);
      const dir = fromLeft ? 1 : -1;
      for (let k = 0; k < steps; k++) {
        x += dir * (60 + r() * W * 0.16);
        d += ` H${x.toFixed(0)}`;
        if (k < steps - 1) {
          const dy = (r() < 0.5 ? -1 : 1) * 20 * (1 + Math.floor(r() * 2));
          x += dir * Math.abs(dy);
          y += dy;
          d += ` L${x.toFixed(0)} ${y}`;
        }
      }
      out += `<path d="${d}" fill="none" stroke="#cbd5e1" stroke-width="1.5"/>`;
      out += `<circle cx="${x.toFixed(0)}" cy="${y}" r="3.5" fill="${r() < 0.18 ? '#3b82f6' : '#94a3b8'}"/>`;
      pulses += `<path class="pulse" d="${d}"/>`;
    }
    svg.innerHTML = out + pulses;
    animatePulses(svg, r);
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function animatePulses(svg: SVGSVGElement, r: () => number) {
    if (reduceMotion) return;
    const SPEED = 170;
    svg.querySelectorAll<SVGPathElement>('path.pulse').forEach((p) => {
      const len = p.getTotalLength();
      const dash = 14;
      p.style.strokeDasharray = `${dash} ${len + dash}`;
      const duration = ((len + dash) / SPEED) * 1000;
      p.animate([{ strokeDashoffset: len + dash }, { strokeDashoffset: 0 }], {
        duration,
        iterations: Infinity,
        delay: -r() * duration,
        easing: 'linear',
      });
    });
  }

  const circuits = Array.from(document.querySelectorAll<SVGSVGElement>('svg.circuit'));
  const drawAll = () => circuits.forEach(drawCircuit);
  drawAll();
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(drawAll, 200);
  });

  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Kopyalandı';
      } catch {
        btn.textContent = 'Kopyalanamadı';
      }
      window.setTimeout(() => (btn.textContent = 'Kopyala'), 1600);
    });
  });
</script>

<style is:global>
  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
  .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--blue); font-weight: 600; }
  h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: .005em; text-wrap: balance; margin: 0; color: var(--ink); }
  h2 { font-size: clamp(32px, 5vw, 42px); line-height: 1.1; }
  .lead { max-width: 62ch; margin: 0; font-weight: 500; color: var(--sub); }
  section { position: relative; }
  .sec { padding-block: 88px; }
  .sec-head { display: grid; gap: 14px; margin-bottom: 44px; }
  .sec-head.flush { margin: 0; }

  .nav { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, .9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 22px; white-space: nowrap; color: var(--ink); }
  .brand img { height: 34px; width: auto; }
  .brand span { color: var(--blue); }
  .nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; font-size: 14px; font-weight: 600; color: var(--sub); }
  .nav ul a { text-decoration: none; transition: color 0.2s; }
  .nav ul a:hover { color: var(--blue); }
  @media (max-width: 760px) { .nav ul { display: none; } }

  .btn { display: inline-flex; align-items: center; gap: 10px; font: 600 15px var(--sans); text-decoration: none; border-radius: 8px; padding: 13px 20px; border: 1px solid transparent; cursor: pointer; transition: background .2s, border-color .2s, transform .2s; }
  .btn-primary { background: var(--blue); color: #fff; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39); }
  .btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); }
  .btn-ghost { border-color: var(--trace-hi); color: var(--ink); background: var(--navy); }
  .btn-ghost:hover { border-color: var(--blue); color: var(--blue); }
  .btn-sm { padding: 9px 14px; font-size: 14px; }
  .btn:focus-visible, a:focus-visible, button:focus-visible { outline: 2px solid var(--sky); outline-offset: 3px; }

  .hero { position: relative; overflow: hidden; background: radial-gradient(ellipse 70% 60% at 72% 42%, rgba(59, 130, 246, .1), transparent 70%), linear-gradient(180deg, var(--night), var(--navy)); border-bottom: 1px solid var(--line); }
  .circuit { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.5; }
  .circuit .pulse { stroke: var(--sky); stroke-width: 2; fill: none; stroke-dasharray: 0 100000; stroke-linecap: round; opacity: .85; }
  @media (prefers-reduced-motion: reduce) { .circuit .pulse { opacity: 0; } }
  .hero .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 40px; padding-block: 84px 96px; }
  .hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.05; margin: 18px 0 22px; }
  .hero h1 em { font-style: normal; color: var(--blue); }
  .hero .lead { font-size: 18px; color: var(--sub); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .pillars { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 36px 0 0; padding: 0; list-style: none; font-family: var(--sans); font-weight: 600; font-size: 14px; color: var(--ink); }
  .pillars li { display: flex; align-items: center; gap: 8px; }
  .pillars li::before { content: ""; width: 8px; height: 8px; border-radius: 2px; background: var(--blue); }
  .owlwrap { position: relative; display: grid; place-items: center; }
  .owlwrap .ring { position: absolute; width: min(420px, 90%); aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--trace-hi); opacity: .55; }
  .owlwrap .ring.r2 { width: min(320px, 70%); border-style: dashed; opacity: .35; }
  .owlwrap img { position: relative; width: min(240px, 70%); height: auto; filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.15)); }
  @media (max-width: 860px) {
    .hero .wrap { grid-template-columns: 1fr; padding-block: 56px 64px; }
    .owlwrap { order: -1; }
    .owlwrap img { width: min(150px, 40%); }
    .owlwrap .ring { width: min(260px, 70%); }
    .owlwrap .ring.r2 { width: min(200px, 54%); }
  }

  .about { background: var(--navy); border-bottom: 1px solid var(--line); }
  .about .wrap { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: start; padding-block: 48px; }
  .about p { margin: 0; font-size: clamp(18px, 2.2vw, 22px); line-height: 1.5; max-width: 60ch; color: var(--ink); }
  .about p b { color: var(--blue); font-weight: 600; }
  @media (max-width: 700px) { .about .wrap { grid-template-columns: 1fr; gap: 12px; } }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--navy); box-shadow: var(--shadow-soft); }
  .svc { padding: 30px 28px 32px; display: grid; gap: 14px; align-content: start; border-right: 1px solid var(--line); }
  .svc:last-child { border-right: 0; }
  .svc .ico { width: 44px; height: 44px; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--trace); display: grid; place-items: center; }
  .svc .ico svg { width: 24px; height: 24px; }
  .svc h3 { font-size: 24px; line-height: 1.2; color: var(--ink); }
  .svc p { margin: 0; color: var(--sub); }
  .svc ul { list-style: none; margin: 6px 0 0; padding: 14px 0 0; border-top: 1px dashed var(--trace-hi); display: grid; gap: 6px; font-size: 14px; font-weight: 500; color: var(--ink); }
  .svc ul li { display: flex; gap: 10px; }
  .svc ul li::before { content: "✓"; color: var(--blue); font-weight: 800; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tags span { font-family: var(--mono); font-size: 11px; font-weight: 600; color: var(--blue); background: var(--ice); border: 1px solid var(--trace-hi); padding: 4px 8px; border-radius: 5px; }
  @media (max-width: 900px) {
    .services { grid-template-columns: 1fr; }
    .svc { border-right: 0; border-bottom: 1px solid var(--line); }
