---
// Tüm sayfalarda ortak olan iskelet: <head>, yazı tipleri, renkler (tasarım tokenları).
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ANS Yazılım & Veri Çözümleri | İşinizi Büyüten Teknoloji',
  description = 'ANS Yazılım; kurumsal web siteleri, özel web uygulamaları (SaaS) ve veri analitiği hizmetleri sunan güvenilir teknoloji çözüm ortağınızdır.',
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/png" href="/logo_2.png" />

    <!-- Sosyal medyada paylaşıldığında görünecek önizleme (Open Graph) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.ansyazilim.com/og-image.jpg" />
    <meta property="og:url" content="https://www.ansyazilim.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Aydınlık Tema (Light Theme) Marka Renkleri */
  :root {
    --night: #f8fafc; /* Ana Zemin - Çok açık gri */
    --navy: #ffffff;  /* Kutu Zeminleri - Beyaz */
    --panel: #ffffff;
    --panel-2: #eff6ff; /* İkon Arka Planları - Açık mavi */
    
    --trace: #e2e8f0; /* Çizgiler ve Borderlar */
    --trace-hi: #cbd5e1; /* Hover Borderlar */
    
    --blue: #2563eb; /* Birincil Butonlar ve Vurgular */
    --sky: #3b82f6;  /* İkonlar ve Siber Devre */
    --ice: #eff6ff;  /* Etiket (Tag) Arka Planı */
    
    --ink: #0f172a;  /* Ana Başlıklar - Koyu Gri/Siyah */
    --sub: #475569;  /* Paragraf Metinleri */
    --faint: #64748b; /* Pasif Metinler ve Tarihler */
    
    --line: rgba(0, 0, 0, 0.08); /* İnce ayrım çizgileri */
    --shadow-soft: 0 10px 30px -10px rgba(0, 0, 0, 0.08); /* Kutu gölgeleri */

    --display: 'Antonio', 'Oswald', 'Arial Narrow', sans-serif;
    --sans: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
    color-scheme: light;
  }
  
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--night);
    color: var(--sub);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
  }
  a {
    color: inherit;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>